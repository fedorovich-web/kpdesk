# Local development settings. Copy to .env; never commit the real file.
KP_DESK_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
KP_DESK_DB_PORT=55432
# Database runtime user (non-superuser); must be provisioned before starting live API.
KP_DESK_APP_PASSWORD=REPLACE_WITH_RANDOM_SECRET

# Public tenant runtime: provide these through the deployment platform's
# protected environment/secret mounts, NOT by committing a populated .env.
# KP_DESK_PUBLIC_ORIGIN=https://kpdesk.ru
# KP_DESK_DB_HOST=db
# KP_DESK_DB_PORT=5432
# KP_DESK_SERVICE_CREDENTIALS_FILE=/run/secrets/kpdesk-runtime-db.json
# Public entrypoint: kpdesk.production:create_production_app --factory.
# The legacy kpdesk.main:app MUST NOT be exposed to the Internet.

# Fixed OpenRouter free route. Enter the key server-side; never send it in chat.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REQUESTS_PER_MINUTE=20
# 50 is conservative; raise only after verifying account eligibility (ceiling 1000).
OPENROUTER_DAILY_REQUEST_LIMIT=50
OPENROUTER_MAX_PARALLEL=1
OPENROUTER_MAX_CALLS_PER_QUOTE=6
# Explicitly authorized catalog processing; synthetic_only remains an opt-in test mode.
OPENROUTER_DATA_MODE=real_catalogs
OPENROUTER_TEST_PROJECT_APPROVED=false

# Separate local owner credential for private quote revisions and PDF.
# Random secret >=40 characters. This is NOT the PostgreSQL or OpenRouter password.
KP_DESK_OWNER_TOKEN=

# Optional process-environment-only backend PDF font paths (two local TTF files with Cyrillic glyphs).
# PDF module reads os.environ; values from this file are not loaded automatically.
# Defaults: Windows Arial; Linux DejaVuSans. Provision fonts in the container
# and verify license before exposing PDF generation in production.
# KP_DESK_PDF_FONT_REGULAR=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# KP_DESK_PDF_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Transactional confirmation emails — Resend only, server-side.
# Use a sending-only API key restricted to verified kpdesk.ru.
# Never expose the key through Vite/frontend, logs, or browser API responses.
KP_DESK_RESEND_API_KEY=

# Optional DaData company lookup: process environment or root .env, server-side only.
# Missing key disables lookup with a clear 503. Restart the backend after changing.
# Never expose this value through Vite, browser responses, or logs.
# Limits/cache are per backend process: 10 requests/min/org, 1000 upstream attempts/24h.
KP_DESK_DADATA_API_KEY=

# Lava one-time 30-day access. Keep disabled until separately reviewed activation
# applies migration 0048 and enables its database configuration. All values stay
# server-side; use the platform's protected environment, never browser settings.
KP_DESK_LAVA_ENABLED=false
KP_DESK_LAVA_API_KEY=
KP_DESK_LAVA_WEBHOOK_SECRET=
KP_DESK_LAVA_START_PRODUCT_ID=
KP_DESK_LAVA_START_OFFER_ID=
KP_DESK_LAVA_TEAM_PRODUCT_ID=
KP_DESK_LAVA_TEAM_OFFER_ID=
KP_DESK_LAVA_BUSINESS_PRODUCT_ID=
KP_DESK_LAVA_BUSINESS_OFFER_ID=
